# Supabase Cloud Configuration Example
# Replace placeholder values with your Supabase project settings

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Production setting: false to connect to real Supabase Cloud
VITE_DEV_MODE=false

# PhonePe Gateway Configuration (Edge Functions / Server-Side only — DO NOT expose in frontend)
# Obtain from PhonePe Merchant Portal (https://business.phonepe.com)
PHONEPE_MERCHANT_ID=YOUR_PHONEPE_MERCHANT_ID
PHONEPE_SALT_KEY=YOUR_PHONEPE_SALT_KEY
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=UAT

